# ===== Discord Bot Token (bot chính thức) =====
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-id
GUILD_ID=your-test-server-id

# ===== Server chính (gửi log/notification, KHÔNG ép user vào) =====
MAIN_SERVER_ID=1399471603003428966
NOTIFICATION_CHANNEL_ID=1414963290391707779
COMPLETED_QUESTS_CHANNEL_ID=1414963290391707779
VOICE_CHANNEL_ID=1421938834651742270
VOICE_ROLE_ID=1405572212403994684
IMAGE_CHANNEL_ID=1421221274721456242

# ===== Ngôn ngữ mặc định =====
DEFAULT_LANGUAGE=vi

# ===== MongoDB Atlas (BẮT BUỘC) =====
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/discord_quests?retryWrites=true&w=majority

# ===== Proxy (false = không dùng) =====
USE_PROXY=false

# ===== Child process =====
CHILD_PROCESS_COUNT=1
QUESTS_PER_CHILD_PROCESS=999

# ===== Selfbot notification (tùy chọn, để trống nếu không dùng) =====
SELFBOT_TOKEN=
ENABLE_NOTIFICATION_DM=false

# ===== Watchdog =====
# Giờ kiểm tra token hàng ngày (GMT+7), mặc định 6 = 6:00 sáng
WATCHDOG_HOUR_GMT7=6

# ===== Logtail (tùy chọn) =====
LOGTAIL_ENABLE=false
LOGTAIL_SOURCE_TOKEN=
LOGTAIL_INGESTION_HOST=

# ===== Runtime =====
NODE_ENV=production
PORT=10000
HOST=0.0.0.0
TZ=Asia/Ho_Chi_Minh
